# --- Required ---
MONGO_URI=your-mongodb-atlas-connection-string
JWT_SECRET=any-long-random-string
CLIENT_URL=http://localhost:5173

# --- Google Sign-In (optional but referenced in routes/auth.js) ---
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# --- TURN server for calling across strict NATs/mobile networks ---
# Without these, calling falls back to STUN-only (works on same wifi/open
# networks, will fail for some users on mobile data or corporate networks).
EXPRESSTURN_URL=
EXPRESSTURN_USERNAME=
EXPRESSTURN_PASSWORD=

PORT=5000
